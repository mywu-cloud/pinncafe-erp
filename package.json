{
  "name": "pinncafe-erp",
  "private": true,
  "type": "module",
  "scripts": {
    "db:local": "wrangler d1 execute pinncafe-erp --local --file=db/schema.sql && wrangler d1 execute pinncafe-erp --local --file=db/seed.sql",
    "db:remote:schema": "wrangler d1 execute pinncafe-erp --remote --file=db/schema.sql",
    "db:remote:migrate:phase2": "wrangler d1 execute pinncafe-erp --remote --file=db/migrations/002_phase2.sql",
    "db:remote:migrate:opening": "wrangler d1 execute pinncafe-erp --remote --file=db/migrations/003_opening_stock.sql",
    "db:remote:migrate:phase3": "wrangler d1 execute pinncafe-erp --remote --file=db/migrations/004_phase3.sql",
    "db:remote:migrate:phase4": "wrangler d1 execute pinncafe-erp --remote --file=db/migrations/005_phase4.sql",
    "db:remote:seed": "wrangler d1 execute pinncafe-erp --remote --file=db/seed.sql",
    "dev": "wrangler pages dev",
    "deploy": "wrangler pages deploy"
  },
  "devDependencies": {
    "wrangler": "^3.114.17"
  }
}
